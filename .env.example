# Configure these only in the server environment (for example, Netlify).
# Never prefix the key with VITE_ and never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional live product search: Amazon India + Google-indexed Flipkart listings.
# Keep this server-side too. The application works in saved-catalogue mode without it.
SERPAPI_API_KEY=
